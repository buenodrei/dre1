# Required: lets the assistant write replies. Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Required on a real server: any long random text. Protects the saved mailbox password and login cookies.
APP_SECRET=

# Optional but needed for "where is my order?" answers.
# In Shopify admin: Settings > Apps and sales channels > Develop apps > create an app
# with the read_orders and read_customers scopes, install it, and copy the Admin API access token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Optional
PORT=3000
DATA_DIR=./data
POLL_SECONDS=60
